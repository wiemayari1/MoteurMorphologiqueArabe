# ============================================================
# .gitignore — Moteur Morphologique Arabe
# ============================================================

# ── Build / Compilation ─────────────────────────────────────
build/

# Compiled binaries (si build/ n'est pas ignoré globalement)
*.exe
*.out
*.o
*.a
*.so
*.dll
*.dylib

# ── CMake ────────────────────────────────────────────────────
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CTestTestfile.cmake
_CPack_Packages/
*.cmake
!CMakeLists.txt

# ── Node.js / NPM (racine + frontend) ───────────────────────
node_modules/
package-lock.json
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ── Next.js (frontend) ──────────────────────────────────────
frontend/.next/
frontend/out/
frontend/dist/
frontend/node_modules/
frontend/.env*.local
frontend/npm-debug.log*

# ── Environnement ────────────────────────────────────────────
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# ── IDE / Éditeurs ───────────────────────────────────────────
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# ── OS spécifique ────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db

# ── Logs & fichiers temporaires ──────────────────────────────
*.log
tmp/
temp/
