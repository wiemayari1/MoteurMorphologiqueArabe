# --- Moteur Morphologique Arabe ---

# Node/Next.js (Frontend)
frontend/.next/
frontend/out/
frontend/dist/
frontend/node_modules/
frontend/.env*.local
frontend/npm-debug.log*

# C++ / CMake (Backend)
# Note: Currently build/ is tracked locally and on remote as requested.
# To ignore FUTURE artifacts but keep existing, we leave it as is or use specific rules.
build/CMakeFiles/
build/CMakeCache.txt
build/Makefile
build/cmake_install.cmake
build/moteur_tests
build/moteur_cli
build/moteur_tui
build/morpho_api_server
# (We add the binaries above just in case they were not already tracked, 
# but usually, standard practice is to ignore the whole build folder)
# build/

# Root Level Dependencies
node_modules/
package-lock.json (Optional: usually tracked)
!.gitignore

# IDE / OS Specific
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
*.sublime-project
*.sublime-workspace

# Logs & Temporary Files
*.log
tmp/
temp/
